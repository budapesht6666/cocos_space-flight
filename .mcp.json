{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--viewport-size",
        "390x844",
        "--caps",
        "vision",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "cocos": {
      "type": "http",
      "url": "http://127.0.0.1:28456/"
    },
    "bingeplay": {
      "type": "http",
      "url": "https://api.funizzle.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BINGEPLAY_TOKEN}"
      }
    }
  }
}
