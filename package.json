{
  "name": "space-flight-tooling",
  "private": true,
  "type": "module",
  "description": "Repo-level tooling for the Space Flight Cocos project: unit tests and type checking",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p game/tsconfig.json",
    "build:ships": "node tools/assets/build-ships.mjs",
    "build:props": "node tools/assets/build-props.mjs",
    "deploy:web": "node tools/deploy-web.mjs",
    "build:web": "node tools/build-web.mjs",
    "release:web": "node tools/build-web.mjs && node tools/deploy-web.mjs --from .cache/cli-game/build/web-mobile",
    "hooks:install": "git config core.hooksPath tools/hooks",
    "serve:web": "python tools/serve_web.py"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vitest": "^5.0.3"
  }
}
